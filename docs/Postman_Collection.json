					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "5000",
					"path": [
						"metrics"
					]
				},
				"description": "Exibe o dump das métricas da aplicação no padrão Prometheus para coleta do agente."
			},
			"response": []
		}
